{
  "name": "bloated",
  "version": "1.1.0",
  "description": "Cache cleaner and virus scanner for Windows",
  "main": "dist/main/main/main.js",
  "scripts": {
    "dev:renderer": "vite --config vite.config.ts",
    "dev:main": "tsc -p src/main/tsconfig.json --watch",
    "dev": "npm run build:main && concurrently \"npm run dev:renderer\" \"npm run dev:main\" \"node scripts/dev-electron.js\"",
    "start": "npm run build && node -e \"const {spawn}=require('child_process');spawn(String(require('electron')),['.'],{stdio:'inherit'}).on('close',()=>process.exit())\"",
    "build:main": "tsc -p src/main/tsconfig.json",
    "build:renderer": "vite build --config vite.config.ts",
    "build": "npm run build:main && npm run build:renderer",
    "pack": "npm run build && electron-builder --win --config electron-builder.yml"
  },
  "keywords": [
    "cache-cleaner",
    "virus-scanner",
    "electron"
  ],
  "author": "",
  "license": "MIT",
  "type": "commonjs",
  "devDependencies": {
    "@types/node": "^25.5.2",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "concurrently": "^9.2.1",
    "electron": "^41.2.0",
    "electron-builder": "^26.8.1",
    "png-to-ico": "^3.0.1",
    "sharp": "^0.34.5",
    "typescript": "^6.0.2",
    "vite": "^8.0.7"
  },
  "dependencies": {
    "electron-store": "^11.0.2",
    "fast-glob": "^3.3.3",
    "lucide-react": "^1.7.0",
    "react": "^19.2.5",
    "react-dom": "^19.2.5",
    "react-router-dom": "^7.14.0",
    "readdirp": "^5.0.0",
    "trash": "^10.1.1"
  }
}
